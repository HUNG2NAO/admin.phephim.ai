# Shared existing Neon PostgreSQL database (server-only)
DATABASE_URL=
# Clerk authentication: configure at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Require explicit allowlisted Clerk user IDs; no default admin access.
ADMIN_CLERK_USER_IDS=
# Optional: used only after separate Blob storage provisioning
BLOB_READ_WRITE_TOKEN=
# Optional: fixed trusted public GitHub static catalog path
STATIC_CATALOG_URL=https://raw.githubusercontent.com/LETAN-Media/phephim/main/app/data/movies.json
