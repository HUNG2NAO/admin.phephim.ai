# Shared existing Neon PostgreSQL database (server-only)
DATABASE_URL=

# Custom authentication (replaces Clerk)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin credentials (username / password hash)
# Password hash: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD'+'phephim-salt').digest('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional: used only after separate Blob storage provisioning
BLOB_READ_WRITE_TOKEN=

# Optional: fixed trusted public GitHub static catalog path
STATIC_CATALOG_URL=https://raw.githubusercontent.com/LETAN-Media/phephim/main/app/data/movies.json